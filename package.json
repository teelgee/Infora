{
  "name": "infora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:tools": "vitest run",
    "lint": "eslint .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:tickets": "node scripts/check-tickets.mjs",
    "check:questions": "node scripts/check-questions.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:audit": "pnpm audit --prod",
    "check": "pnpm run check:deps && pnpm run check:source && pnpm run check:tickets && pnpm run check:questions && pnpm run check:docs && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.1.0"
  }
}
