    "labelColor": "black",
    "color": "black",
    "fill": "none",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Sandbox document \u2014 the live head",
         "marks": [
          {
           "type": "bold"
          }
         ]
        }
       ]
      },
      {
       "type": "paragraph",
       "content": []
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "mutable by design. Ambient history auto-snapshots every save (SharePoint-style): browsable, restorable, a working tool \u2014 nothing review-grade binds to it and it never grounds (ADR-0011)"
        }
       ]
      }
     ]
    }
   }
  },
  {
   "typeName": "shape",
   "id": "shape:s2",
   "type": "geo",
   "x": 620,
   "y": 90,
   "rotation": 0,
   "index": "a4",
   "parentId": "page:page",
   "isLocked": false,
   "opacity": 1,
   "meta": {},
   "props": {
    "geo": "rectangle",
    "dash": "draw",
