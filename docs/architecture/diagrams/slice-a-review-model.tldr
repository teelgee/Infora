    "color": "black",
    "fill": "none",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Collaborate on the head (modes 1\u20132)",
         "marks": [
          {
           "type": "bold"
          }
         ]
        }
       ]
      },
      {
       "type": "paragraph",
       "content": []
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "informal + QA review: human marked-up edits and comments (new primitive, human authorship \u2014 no Signal) beside agent Suggestions; every anchor advisory \u2014 drift degrades, never blocks"
        }
       ]
      }
     ]
    }
   }
  },
  {
   "typeName": "shape",
   "id": "shape:s3",
   "type": "geo",
   "x": 1180,
