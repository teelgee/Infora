{
  "name": "@infora/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres + pgvector: schema, migrations, seed",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "datamodel": "tsx scripts/generate-data-model.ts",
    "datamodel:check": "tsx scripts/generate-data-model.ts --check",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.6.7"
  }
}
