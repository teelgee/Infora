    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "→ next promotion opens a fresh round, until the lead reviewer applies an accepting code — the deliverable, not the version, is what gets accepted"
        }
       ]
      }
     ]
    },
    "scale": 1,
    "autoSize": false
   }
  },
  {
   "typeName": "shape",
   "id": "shape:invariants",
   "type": "geo",
   "x": 2440,
   "y": 1060,
   "rotation": 0,
   "index": "aY",
   "parentId": "page:page",
   "isLocked": false,
   "opacity": 1,
   "meta": {},
   "props": {
    "geo": "rectangle",
    "dash": "draw",
    "url": "",
    "w": 820,
    "h": 420,
    "growY": 0,
    "scale": 1,
    "labelColor": "grey",
    "color": "grey",
    "fill": "none",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Invariants the build must hold",
         "marks": [
          {
           "type": "bold"
          }
         ]
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· one live DRR per deliverable, append-only, spanning every version — users only ever work in the live DRR; snapshots are internal (ADR-0009)"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· only one round open at a time — this is what guarantees the consultant sees every round but the open one (ADR-0014)"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· one edit lock, alternating at each transmittal; issued rounds are permanently visible to everyone"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· review happens on the frozen PDF — anchors never drift (ADR-0004/0006)"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· rounds close by human action, never the clock (ADR-0005)"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "· access (visibility + lock) is resolved by the access model, never here (ADR-0014)"
        }
       ]
      }
     ]
    }
   }
  }
 ]
}