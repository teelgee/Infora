# Copy to .env — values below match the docker-compose dev substrate.

# The APPLICATION connection (T-247). Deliberately NOT the owner: a Postgres
# superuser bypasses row-level security entirely, so connecting as `infora`
# would make the RLS backstop on the grounding index theatre. Migration 0034
# creates this role and grants it exactly what the app needs.
DATABASE_URL=postgres://infora_app:infora_app@localhost:5432/infora

# The OWNER connection, used only by `pnpm --filter @infora/db run migrate`,
# which creates and alters objects the application role may not.
MIGRATE_DATABASE_URL=postgres://infora:infora@localhost:5432/infora

# API port (default 3000).
# PORT=3000

# Session-cookie signing key — required, the API refuses to boot without it
# (T-206). Generate your own: `openssl rand -hex 32`.
SESSION_SECRET=

# Model providers (needed from T-012 ingestion / T-043 draft leaf onward).
# ANTHROPIC_API_KEY=sk-ant-...
# VOYAGE_API_KEY=pa-...

# CORS allowlist (T-216), comma-separated origins. Unset = the local dev/e2e
# web origins only; in dev the web app rides the vite proxy (same-origin).
# ALLOWED_ORIGINS=https://app.example.com

# Request throttles (T-217). Unset = the in-code defaults shown.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_RUNS_PER_MINUTE=30

# Session clocks (T-251). Two different controls: the absolute lifetime bounds
# how long a stolen cookie is useful at all and is never extended by activity;
# the idle window ends a session someone walked away from. Unset = the in-code
# defaults shown, which the infra/security session will replace with real ones.
# SESSION_ABSOLUTE_HOURS=12
# SESSION_IDLE_MINUTES=60

# Provider rates per model id (T-254), as JSON. Deployment configuration and
# nothing else: provider pricing changes without warning, moves per region and
# is negotiated per customer, so a number compiled into the repo would be wrong
# somewhere from the day it was written. UNSET means every step records
# `cost: null` — unpriced, and reported as such — never 0, which reads as free.
# A malformed table refuses to boot rather than reporting confident wrong
# numbers. Rates are per MILLION tokens, in the deployment's own currency.
# MODEL_RATES={"claude-sonnet-4-5":{"promptPerMTok":3,"completionPerMTok":15}}

# The Lens the Ask picker preselects (T-283) — one of the ids in
# packages/lenses/definitions/. Config, not code: which register a firm's
# people start in is a deployment decision. Unset = no Lens preselected, which
# answers under the shared core alone.
# DEFAULT_LENS_ID=planning-environmental
