     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Freeze \u2014 'check out'",
         "marks": [
          {
           "type": "bold"
          }
         ]
        }
       ]
      },
      {
       "type": "paragraph",
       "content": []
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "snapshot the head \u2192 an immutable frozen Version at sandbox scope. Same primitive as promotion, different target scope. The head locks while a round is open; audited early release by the lead"
        }
       ]
      }
     ]
    }
   }
  },
  {
