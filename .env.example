# Copy to .env — values below match the docker-compose dev substrate.
DATABASE_URL=postgres://infora:infora@localhost:5432/infora

# API port (default 3000).
# PORT=3000

# Session-cookie signing key — required, the API refuses to boot without it
# (T-206). Generate your own: `openssl rand -hex 32`.
SESSION_SECRET=

# Model providers (needed from T-012 ingestion / T-043 draft leaf onward).
# ANTHROPIC_API_KEY=sk-ant-...
# VOYAGE_API_KEY=pa-...

# CORS allowlist (T-216), comma-separated origins. Unset = the local dev/e2e
# web origins only; in dev the web app rides the vite proxy (same-origin).
# ALLOWED_ORIGINS=https://app.example.com

# Request throttles (T-217). Unset = the in-code defaults shown.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_RUNS_PER_MINUTE=30
