{
  "name": "@infora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "only deployable that touches the DB and models",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./test-router": "./src/test-router.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file=../../.env --import tsx src/index.ts",
    "start:e2e": "tsx src/e2e-server.ts",
    "bulk-load": "node --env-file=../../.env --import tsx src/run-bulk-load.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@infora/contracts": "workspace:*",
    "@infora/data": "workspace:*",
    "@infora/db": "workspace:*",
    "@infora/governance": "workspace:*",
    "@infora/knowledge": "workspace:*",
    "@infora/lenses": "workspace:*",
    "@infora/model": "workspace:*",
    "@infora/orchestration": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
