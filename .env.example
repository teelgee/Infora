# Copy to .env — values below match the docker-compose dev substrate.

# The APPLICATION connection (T-247). Deliberately NOT the owner: a Postgres
# superuser bypasses row-level security entirely, so connecting as `infora`
# would make the RLS backstop on the grounding index theatre. Migration 0034
# creates this role and grants it exactly what the app needs.
DATABASE_URL=postgres://infora_app:infora_app@localhost:5432/infora

# The OWNER connection, used only by `pnpm --filter @infora/db run migrate`,
# which creates and alters objects the application role may not.
MIGRATE_DATABASE_URL=postgres://infora:infora@localhost:5432/infora

# API port (default 3000).
# PORT=3000

# Session-cookie signing key — required, the API refuses to boot without it
# (T-206). Generate your own: `openssl rand -hex 32`.
SESSION_SECRET=

# Model providers. REQUIRED TO BOOT — apps/api/src/env.ts validates the whole
# env eagerly and requires both as non-empty strings, so leaving them unset
# stops the API starting at all. Real values are only exercised from T-012
# ingestion / T-043 draft leaf onward; the placeholders below boot fine for a
# database-only first day and fail loudly at the first real provider call.
ANTHROPIC_API_KEY=placeholder-boots-but-cannot-draft
VOYAGE_API_KEY=placeholder-boots-but-cannot-embed

# In-browser editing of uploaded Office files (T-453/T-454, ADR-0043) —
# optional. EDITOR_ENGINE_URL is the editing engine (`docker compose --profile
# editing up -d` starts Collabora on :9980); WOPI_HOST_URL is THIS API as the
# engine reaches it from inside docker; EDITOR_POST_MESSAGE_ORIGIN is the web
# app's origin. Unset EDITOR_ENGINE_URL = no browser editing, nothing else
# changes. WOPI_TOKEN_MINUTES bounds an engine's pass (default 60).
# EDITOR_ENGINE_URL=http://localhost:9980
# WOPI_HOST_URL=http://host.docker.internal:3000
# EDITOR_POST_MESSAGE_ORIGIN=http://localhost:5173
# WOPI_TOKEN_MINUTES=60

# CORS allowlist (T-216), comma-separated origins. Unset = the local dev/e2e
# web origins only; in dev the web app rides the vite proxy (same-origin).
# ALLOWED_ORIGINS=https://app.example.com

# Request throttles (T-217). Unset = the in-code defaults shown.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_RUNS_PER_MINUTE=30

# Session clocks (T-251). Two different controls: the absolute lifetime bounds
# how long a stolen cookie is useful at all and is never extended by activity;
# the idle window ends a session someone walked away from. Unset = the in-code
# defaults shown, which the infra/security session will replace with real ones.
# SESSION_ABSOLUTE_HOURS=12
# SESSION_IDLE_MINUTES=60

# Provider rates per model id (T-254), as JSON. Deployment configuration and
# nothing else: provider pricing changes without warning, moves per region and
# is negotiated per customer, so a number compiled into the repo would be wrong
# somewhere from the day it was written. UNSET means every step records
# `cost: null` — unpriced, and reported as such — never 0, which reads as free.
# A malformed table refuses to boot rather than reporting confident wrong
# numbers. Rates are per MILLION tokens, in the deployment's own currency.
# MODEL_RATES={"claude-sonnet-4-5":{"promptPerMTok":3,"completionPerMTok":15}}

# Pin every Ask turn to one declared workflow (T-265; an OVERRIDE since
# T-266): set, the named workflow runs on every turn and classification is
# skipped; unset — the shipped default — a turn is classified rather than
# assigned. Ids come from the loaded workflow definitions.
# ASK_WORKFLOW_ID=project-question

# The Lens the Ask picker preselects (T-283) — one of the ids in
# packages/lenses/definitions/. Config, not code: which register a firm's
# people start in is a deployment decision. Unset = no Lens preselected, which
# answers under the shared core alone.
# DEFAULT_LENS_ID=planning-environmental

# The chat fallback chain (T-285), as JSON. Deployment configuration: a chain
# is a list of PROCUREMENTS, and which endpoints a firm has bought is not
# something the repository can know. UNSET — the shipped default — means the
# single route the MODEL_* variables above describe, and the chain is one long.
#
# Each route declares its OWN four egress attributes; none is inherited from
# the MODEL_* defaults, because inheritance is how a second procurement quietly
# adopts the first one's compliance claims. `endpoint` is both the audited
# egress fact and the client's base URL — two fields would let the record name
# a host the call never touched. `apiKeyEnv` names the env var holding that
# route's credential (default ANTHROPIC_API_KEY); `serves` names the model
# tiers (triage | mid | frontier) the route is configured for, and omitting it
# means the route serves every task class. A malformed chain refuses to boot.
#
# A fallback is attempted only when a route was UNAVAILABLE — a provider
# outage, a rate limit, a timeout. A route that answered, including a model
# that refused, ends the call: retrying a refusal on the next model is shopping
# for one that complies. And a fallback is only ever another route that already
# conforms to DEPLOYMENT_TIER; availability is never traded for conformance.
# MODEL_CHAT_ROUTES=[{"modelId":"claude-opus-4-8","endpoint":"https://uk.example/v1","serves":["frontier"],"region":"uk","retention":"zero","jurisdiction":"uk-sovereign","eligibility":"enterprise-zdr"},{"modelId":"claude-sonnet-4-5","endpoint":"https://fallback.example/v1","apiKeyEnv":"FALLBACK_API_KEY","region":"uk","retention":"zero","jurisdiction":"uk-sovereign","eligibility":"enterprise-zdr"}]

# The chain's two bounds (T-285). Both bound a bad day rather than tune a good
# one: how many conforming routes one call may burn before it gives up, and how
# long one attempt may take before it counts as an outage. Unset = the whole
# chain, and no timeout.
# MODEL_FALLBACK_ATTEMPTS=2
# MODEL_ATTEMPT_TIMEOUT_MS=60000
