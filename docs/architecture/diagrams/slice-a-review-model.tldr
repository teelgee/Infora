    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Sandbox \u2014 the org-private working area, SharePoint-shaped: a mutable head with ambient version history",
         "marks": [
          {
           "type": "bold"
          }
         ]
        }
       ]
      }
     ]
    }
   }
  },
  {
   "typeName": "shape",
   "id": "shape:s1",
   "type": "geo",
