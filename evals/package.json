{
  "name": "@infora/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Ask eval harness (T-255): cases and fixtures as data, executed through the real HTTP API",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
